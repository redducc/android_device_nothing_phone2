cc_library_shared {
    name: "libntcam_shim",
    srcs: ["ntcam_shim.cpp"],
    shared_libs: ["libui"],
    vendor: true,
}

cc_library_shared {
    name: "libcamhidl_shim",
    srcs: ["camhidl_shim.cpp"],
    local_include_dirs: ["include"],
    include_dirs: [
        "hardware/interfaces/camera/common/default/include",
    ],
    shared_libs: [
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder_ndk",
        "libcamera_metadata",
        "libcutils",
        "libhidlbase",
        "libutils",
        "vendor.qti.hardware.camera.postproc-V2-ndk",
        "vendor.qti.hardware.camera.postproc@1.0-nothing",
    ],
    static_libs: ["libaidlcommonsupport"],
    vendor: true,
}
